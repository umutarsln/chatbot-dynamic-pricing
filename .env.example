# Optional: Open-Meteo commercial subscription key. Server-side only.
# Without a key, the non-commercial evaluation endpoint is used.
OPEN_METEO_API_KEY=

# Optional absolute path on a persistent writable volume. Default: var/weather.sqlite
WEATHER_HISTORY_DB_PATH=

# Makcorps local pilot only. Never use a NEXT_PUBLIC_ prefix.
MAKCORPS_API_KEY=
